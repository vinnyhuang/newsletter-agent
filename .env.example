# Copy to .env and fill in. Loaded by src/config/env.ts.

# --- Database ---------------------------------------------------------------
# Postgres is the source of truth for articles, summaries, and artifact versions.
DATABASE_URL=postgres://localhost:5432/newsletter_agent

# Agent concurrency and the runaway-guard ceiling are NOT set here. They live
# in src/config/agents.ts, in version control; ad-hoc overrides come from CLI
# flags (--concurrency, --max-calls).

# --- Artifacts --------------------------------------------------------------
# Git-ignored, disposable rendered view. Point this outside the repo if you
# prefer. `pnpm render` regenerates it from Postgres.
ARTIFACTS_DIR=./data/artifacts

# --- Langfuse ---------------------------------------------------------------
# A SEPARATE self-hosted deployment outside this repo. See docs/langfuse-setup.md.
# Leave blank to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=http://localhost:3000
