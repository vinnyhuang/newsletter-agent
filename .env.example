# Copy to .env and adjust. Read by TWO consumers:
#   - src/config/env.ts   (the application, validated with zod)
#   - docker-compose.yml  (Compose auto-loads .env from its own directory)
# so these values are the single source of truth — there is nothing to keep in
# sync by hand.

# --- Database ---------------------------------------------------------------
# Postgres is the source of truth for articles, summaries, and artifact versions.
# The connection URL is assembled from these parts in src/config/env.ts.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=newsletter
POSTGRES_PASSWORD=newsletter
POSTGRES_DB=newsletter_agent

# --- Artifacts --------------------------------------------------------------
# Git-ignored, disposable rendered view. Point this outside the repo if you
# prefer. `pnpm render` regenerates it from Postgres.
ARTIFACTS_DIR=./data/artifacts

# --- Langfuse ---------------------------------------------------------------
# A SEPARATE self-hosted deployment outside this repo. See docs/langfuse-setup.md.
# Leave blank to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=http://localhost:3000
